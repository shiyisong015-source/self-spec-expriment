diff --git a/vllm/v1/selfspec_profile.py b/vllm/v1/selfspec_profile.py
new file mode 100644
index 0000000000..60f1e8dd1e
--- /dev/null
+++ b/vllm/v1/selfspec_profile.py
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in structured logging and NVTX ranges for self-spec profiling."""
+
+import json
+import os
+import sys
+import time
+from contextlib import contextmanager
+from functools import lru_cache
+from typing import Any, Iterator
+
+
+@lru_cache(maxsize=1)
+def enabled() -> bool:
+    return os.getenv("VLLM_SELFSPEC_PROFILE", "0").lower() in (
+        "1", "true", "yes", "on")
+
+
+def emit(event: str, **fields: Any) -> None:
+    if not enabled():
+        return
+    record = {"timestamp": time.time(), "event": event, **fields}
+    line = json.dumps(record, sort_keys=True, separators=(",", ":"))
+    path = os.getenv("VLLM_SELFSPEC_PROFILE_LOG")
+    if path:
+        with open(path, "a", encoding="utf-8") as output:
+            output.write(line + "\n")
+    else:
+        print(line, file=sys.stderr, flush=True)
+
+
+@contextmanager
+def nvtx_range(name: str) -> Iterator[None]:
+    if not enabled():
+        yield
+        return
+    import torch
+    torch.cuda.nvtx.range_push(name)
+    try:
+        yield
+    finally:
+        torch.cuda.nvtx.range_pop()
